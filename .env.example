# Optional: enables Claude-written analyst summaries. Without it a deterministic template is used.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# Force the offline template even if a key is present (1/true)
LLM_OFFLINE=

# Paths (defaults shown are relative to the project root)
FRAUDSHIELD_DATA=data/transactions.csv.gz
FRAUDSHIELD_NEXT_MONTH=data/next_month.csv.gz
FRAUDSHIELD_REGISTRY=models/registry
FRAUDSHIELD_REPORTS=reports
# OpenMP/BLAS threads for fit + scoring (1 is fastest for single-row latency)
FRAUDSHIELD_THREADS=1
